{# Overrides @SyliusAdmin/shipment/component/ship.html.twig to add a PayPal carrier selector to the
   ship form. Rendered with \Sylius\Bundle\AdminBundle\Twig\Component\Shipment\ShipFormComponent.
   The carrier / carrier_name_other fields come from the ShipmentShipTypeExtension. #}

{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{% set path = path|default('sylius_admin_shipment_ship') %}
{% set path_parameters = path_parameters|default({id: resource.id}) %}

{% set tracking_placeholder = 'sylius.ui.tracking_code'|trans ~ '...' %}

{% if sylius_sm_can(resource, 'sylius_shipment', 'ship') %}
    <div {{ attributes }}>
        {{ form_start(form, {'action': path(path, path_parameters), 'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate'}}) }}
        <input type="hidden" name="_method" value="PUT">
        <div class="d-flex flex-column gap-2" style="min-width: 260px;">
            {{ form_row(form.tracking, sylius_test_form_attribute('shipment-tracking')|sylius_merge_recursive({'attr': {'placeholder': tracking_placeholder}})) }}
            {{ form_row(form.carrier, sylius_test_form_attribute('shipment-carrier')) }}
            {{ form_row(form.carrier_name_other, sylius_test_form_attribute('shipment-carrier-name-other')) }}
            <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('shipment-ship-button') }}>
                {{ ux_icon('tabler:truck') }}
                {{ 'sylius.ui.ship'|trans }}
            </button>
        </div>
        {{ form_end(form, {'render_rest': false}) }}
    </div>
{% endif %}
