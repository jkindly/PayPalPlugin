{% set shipment = hookable_metadata.context.shipment %}
{% set tracking = sylius_paypal_shipment_tracking(shipment) %}

{% if tracking is not null %}
    <div class="py-2" {{ sylius_test_html_attribute('shipment-paypal-tracking-state') }}>
        <strong>{{ 'sylius_paypal.shipment_tracking.paypal_sync'|trans }}:</strong>
        {% if tracking.state == constant('Sylius\\PayPalPlugin\\Entity\\ShipmentTrackingInterface::STATE_SYNCED') %}
            <span class="badge bg-success">{{ 'sylius_paypal.shipment_tracking.state.synced'|trans }}</span>
        {% elseif tracking.state == constant('Sylius\\PayPalPlugin\\Entity\\ShipmentTrackingInterface::STATE_FAILED') %}
            <span class="badge bg-danger" title="{{ tracking.lastError }}">{{ 'sylius_paypal.shipment_tracking.state.failed'|trans }}</span>
        {% else %}
            <span class="badge bg-secondary">{{ 'sylius_paypal.shipment_tracking.state.pending'|trans }}</span>
        {% endif %}

        {% if tracking.carrier is not empty %}
            <div class="text-secondary">
                {{ 'sylius_paypal.shipment_tracking.carrier'|trans }}:
                {{ tracking.carrier == constant('Sylius\\PayPalPlugin\\Provider\\CarrierProviderInterface::OTHER_CARRIER_CODE') ? tracking.carrierNameOther : tracking.carrier }}
            </div>
        {% endif %}

        {% if tracking.state == constant('Sylius\\PayPalPlugin\\Entity\\ShipmentTrackingInterface::STATE_FAILED') and tracking.lastError is not empty %}
            <div class="text-danger small">{{ tracking.lastError }}</div>
        {% endif %}
    </div>
{% endif %}
