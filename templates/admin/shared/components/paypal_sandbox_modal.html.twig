{% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}

<div {{ attributes }} {{ sylius_test_html_attribute('modal', type) }}>
    <div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            {% block content %}
                <div class="modal-content">
                    <div class="modal-header">
                            <h1 class="modal-title py-5">{{ 'sylius_paypal.share_data_consent_confirmation'|trans }}</h1>
                    </div>
                    <div class="modal-body">
                            {% set form = this.formView %}
                            {% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

                           {{ form_errors(form) }}
                            {{ form_start(form, {
                                attr: {
                                    'id': 'paypal-sandbox-form',
                                    'data-action': 'live#action:prevent',
                                    'data-live-action-param': 'submit',
                                    'class': 'w-100'
                                },
                            }) }}

                            {{ form_row(form.clientId) }}
                            {{ form_row(form.clientSecret) }}
                            {{ form_row(form.merchantId) }}
                            {{ form_end(form) }}
                    </div>
                    <div class="modal-footer">
                        <div class="d-flex justify-content-end gap-2">
                            {% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}
                            {{ button.default({
                                text: 'sylius.ui.no_label'|trans,
                                attr: 'data-bs-dismiss=modal',
                                type: 'button'
                            }) }}

                            <button class="btn btn-outline-success" form="paypal-sandbox-form">
                                {{ 'sylius.ui.yes_label'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            {% endblock %}
        </div>
    </div>
</div>
